---
import Layout from '../Layout.astro'
import getProjectTimeEntries from '../services/projectTimeEntries'
import getProject from '../services/project'
import type { ProjectTimeEntry } from '../types'
import Grid from '../components/Grid.astro'

const vesselIndexProjectId = '7f42c483-e6ba-41ff-bcbc-1f4374a8b068'

let date = new Date()

const monthParam = Astro.url.searchParams.get('month')
if (monthParam) {
  date = new Date(monthParam + '-01')
}

const selectedMonth = monthParam
const monthNumber = date.getMonth() + 1
const year = date.getFullYear()
const lastDay = new Date(year, monthNumber, 0).getDate()
const start = `${year}-${monthNumber.toString().padStart(2, '0')}-01T00:00:00Z`
const end = `${year}-${monthNumber.toString().padStart(2, '0')}-${String(lastDay).padStart(2, '0')}T23:59:59Z`

const projectTimeEntries = await getProjectTimeEntries(vesselIndexProjectId, start, end)
const time = getTime(projectTimeEntries)
const project = await getProject(vesselIndexProjectId)
const totalCost = (time.total * (project.billable_rate / 100)).toFixed(2)

const hoursGoal = 60
const totalHoursPercentage = Math.round((time.total / hoursGoal) * 100)

function getTime(entries: ProjectTimeEntry[]) {
  const seconds = entries.reduce((total, entry) => total + (entry.billable ? entry.duration : 0), 0)
  const hours = (seconds / 60 / 60).toFixed(2)
  const relativeMinutes = hours.split('.')[1]
  const minutes = Math.round(60 * Number(relativeMinutes) / 100)

  const total = Number(hours.split('.')[0] + '.' + minutes)
  return {
    total,
    hours: hours.split('.')[0],
    minutes,
  }
}
---

<script>
import '@webawesome/input/input.js'
import '@webawesome/button/button.js'
import '@webawesome/format-date/format-date.js'
import '@webawesome/progress-bar/progress-bar.js'

document.getElementById('month')?.addEventListener('change', (event) => {
  (event.target as HTMLElement).closest('form')?.requestSubmit()
})
</script>

<Layout>
  <Grid tag="form" action="" method="get" align="end">
    <wa-input id="month" type="month" name="month" label="Mês" value={selectedMonth} />
    <button type="submit" class="is-visually-hidden">Submit</button>
  </Grid>

  <h2><wa-format-date date={date} month="long" year="numeric"></wa-format-date></h2>

  <Grid direction="column" gap="xs">
    <div class="progress-bar">
      <div title={time.total + ' horas trabalhadas'} class="progress-bar__label" style={{'inset-inline-end': (100 - totalHoursPercentage) + '%'}}>
        <span class="progress-bar__hours">{time.hours}h {time.minutes}m</span><br>
        {totalCost} €
      </div>
      <wa-progress-bar value={totalHoursPercentage} />
    </div>
    <Grid align="center" justify="end" fullWidth>
      <span class="progress-bar__total" title="Objetivo mensal">{hoursGoal}h</span>
    </Grid>
  </Grid>
  <p></p>

</Layout>

<style>

.progress-bar {
  position: relative;
  width: 100%;
}
.progress-bar__label {
  position: absolute;
  z-index: 1;
  inset-block-start: 50%;
  transform: translateY(-50%);
  color: #FFF;
  font-weight: bold;
  padding-inline-end: var(--wa-space-s);
  text-align: end;
}
.progress-bar__hours {
  font-size: var(--wa-font-size-xl);
}
.progress-bar__total {
  font-weight: bold;
  text-align: end;
}
wa-progress-bar {
  --track-height: 4.5rem;

  &::part(base) {
    border-radius: var(--wa-border-radius-xl);
  }
}
</style>