---
import '@awesome.me/webawesome/dist/styles/themes/default.css'
import getProjectTimeEntries from '../services/projectTimeEntries'
import getProject from '../services/project'
import type { ProjectTimeEntry } from '../types'

const vesselIndexProjectId = '7f42c483-e6ba-41ff-bcbc-1f4374a8b068'
const request = Astro.request
let date = new Date()
let isCurrentMonth = true

const currentMonth = date.getMonth() + 1
const currentYear = date.getFullYear()
const isoMonth = `${currentYear}-${currentMonth.toString().padStart(2, '0')}`

let selectedMonth = isoMonth

if (request.method === 'POST') {
  const formData = await request.formData()
  const month = formData.get('month') as string
  if (month) {
    isCurrentMonth = month === isoMonth
    selectedMonth = month
    date = new Date(month + '-01')
  }
}

const { start, end } = getDates(selectedMonth)
const projectTimeEntries = await getProjectTimeEntries(vesselIndexProjectId, start, end)
const totalHours = getTotalHours(projectTimeEntries)
const project = await getProject(vesselIndexProjectId)
const totalCost = (totalHours * (project.billable_rate / 100)).toFixed(2)

function getDates(month: string): { start: string; end: string } {
  const [yearStr, monthStr] = month.split('-')
  const year = parseInt(yearStr, 10)
  const monthNum = parseInt(monthStr, 10)
  const lastDay = new Date(year, monthNum, 0).getDate()

  const start = `${yearStr}-${monthStr.padStart(2, '0')}-01T00:00:00Z`
  const end = `${yearStr}-${monthStr.padStart(2, '0')}-${String(lastDay).padStart(2, '0')}T23:59:59Z`

  return { start, end }
}

function getTotalHours(entries: ProjectTimeEntry[]): number {
  const seconds = entries.reduce((total, entry) => total + (entry.billable ? entry.duration : 0), 0)
  const hours = (seconds / 60 / 60).toFixed(2)
  const relativeMinutes = hours.split('.')[1]
  const minutes = Math.round(60 * Number(relativeMinutes) / 100)
  return Number(hours.split('.')[0] + '.' + minutes)
}
---

<script>
import '@webawesome/input/input.js'
import '@webawesome/button/button.js'
import '@webawesome/format-date/format-date.js'
</script>

<html lang="pt">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Time Tracker Dashboard</title>
	</head>
	<body>
		<h1>Time Tracker Dashboard</h1>

    <form action="" method="post" >
      <wa-input type="month" name="month" label="Mês" value={selectedMonth} />
      <wa-button type="submit">Buscar</wa-button>
    </form>

    <h2><wa-format-date date={date} month="long" year="numeric" /></h2>

    <p>Total Hours: {totalHours} hours</p>
    <p>Total Cost: {totalCost} €</p>

    {
      projectTimeEntries && projectTimeEntries.length > 0 ? (
        <ul>
          {projectTimeEntries.map((entry: ProjectTimeEntry) => (
            <li>
              <strong>{entry.description || ''}</strong>
              {new Date(entry.start).toLocaleString()} - {new Date(entry.end).toLocaleString()} ({Math.round(entry.duration / 60)} mins)
            </li>
          ))}
        </ul>
      ) : (
        <p>No time entries found.</p>
      )}
	</body>
</html>
