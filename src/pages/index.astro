---
import Layout from '../Layout.astro'
import getProjectTimeEntries from '../services/projectTimeEntries'
import getProject from '../services/project'
import type { Project, ProjectTimeEntry } from '../types'
import Grid from '../components/Grid.astro'

const vesselIndexProjectId = '7f42c483-e6ba-41ff-bcbc-1f4374a8b068'

let year: number
let monthNumber: number
let selectedMonth: string

const monthParam = Astro.url.searchParams.get('month')
if (monthParam && /^\d{4}-\d{2}$/.test(monthParam)) {
  const [y, m] = monthParam.split('-').map(Number)
  year = y
  monthNumber = m
  selectedMonth = monthParam
} else {
  const now = new Date()
  year = now.getFullYear()
  monthNumber = now.getMonth() + 1
  selectedMonth = `${year}-${monthNumber.toString().padStart(2, '0')}`
}

const date = new Date(year, monthNumber - 1, 1)
const lastDay = new Date(year, monthNumber, 0).getDate()
const start = `${year}-${monthNumber.toString().padStart(2, '0')}-01T00:00:00Z`
const end = `${year}-${monthNumber.toString().padStart(2, '0')}-${String(lastDay).padStart(2, '0')}T23:59:59Z`

let projectTimeEntries: ProjectTimeEntry[] = []
let project: Project | null = null
let errorMessage = ''

try {
  const [entries, proj] = await Promise.all([
    getProjectTimeEntries(vesselIndexProjectId, start, end),
    getProject(vesselIndexProjectId),
  ])
  projectTimeEntries = entries || []
  project = proj
} catch (err: any) {
  errorMessage = err?.message || 'Erro ao carregar os dados do projeto.'
}

const time = getTime(projectTimeEntries)
const billableRate = project?.billable_rate ?? 0
const totalCost = (time.decimalHours * (billableRate / 100)).toFixed(2)

const hoursGoal = 60
const totalHoursPercentage = Math.round((time.decimalHours / hoursGoal) * 100)
const displayProgressPercentage = Math.min(100, Math.max(0, totalHoursPercentage))

function getTime(entries: ProjectTimeEntry[]) {
  const billableSeconds = entries.reduce((total, entry) => total + (entry.billable ? entry.duration : 0), 0)
  const totalSeconds = entries.reduce((total, entry) => total + entry.duration, 0)
  const decimalHours = billableSeconds / 3600
  const hours = Math.floor(billableSeconds / 3600)
  const minutes = Math.round((billableSeconds % 3600) / 60)

  return {
    decimalHours,
    hours,
    minutes,
    totalSeconds,
  }
}

function formatDuration(seconds: number) {
  const h = Math.floor(seconds / 3600)
  const m = Math.round((seconds % 3600) / 60)
  if (h === 0) return `${m}m`
  if (m === 0) return `${h}h`
  return `${h}h ${m}m`
}

function formatDate(dateStr: string) {
  const d = new Date(dateStr)
  return d.toLocaleDateString('pt-PT', { day: '2-digit'})
}
---

<script>
import '@webawesome/input/input.js'
import '@webawesome/button/button.js'
import '@webawesome/format-date/format-date.js'
import '@webawesome/progress-bar/progress-bar.js'
import '@webawesome/card/card.js'
import '@webawesome/callout/callout.js'

document.getElementById('month')?.addEventListener('change', (event) => {
  (event.target as HTMLElement).closest('form')?.requestSubmit()
})
</script>

<Layout>
  <Grid tag="form" action="" method="get" align="end">
    <wa-input id="month" type="month" name="month" label="Mês" value={selectedMonth} />
    <button type="submit" class="is-visually-hidden">Submit</button>
  </Grid>

  <h2><wa-format-date date={date} month="long" year="numeric" /></h2>

  {errorMessage ? (
    <wa-callout variant="danger">
      {errorMessage}
    </wa-callout>
  ) : projectTimeEntries.length === 0 ? (
    <wa-card class="empty-card">
      <p class="empty-message">Sem registos de tempo para este mês.</p>
    </wa-card>
  ) : (
    <>
      <Grid direction="column" gap="xs">
        <div class="progress-bar">
          <div
            title={`${time.decimalHours.toFixed(2)} horas faturáveis`}
            class="progress-bar__label"
            style={{
              'inset-inline-end': `${Math.max(0, 100 - displayProgressPercentage)}%`,
            }}
          >
            <span class="progress-bar__hours">{time.hours}h {time.minutes}m</span><br />
            {totalCost} €
          </div>
          <wa-progress-bar value={displayProgressPercentage} />
        </div>
        <Grid align="center" justify="end" fullWidth>
          <span class="progress-bar__total" title="Objetivo mensal">{hoursGoal}h</span>
        </Grid>
      </Grid>

      <section>
        <h3>Registos do mês ({projectTimeEntries.length})</h3>
        <Grid direction="column" gap="xs">
          {projectTimeEntries.map((entry) => (
            <wa-card>
              <Grid align="center" justify="space-between" gap="xs">
                <Grid gap="xs" align="center">
                  <span class="entries_day">{formatDate(entry.start)}</span>
                  { entry.description ? <span>{entry.description}</span> : <span class="entries__no-description">Sem descrição</span> }
                </Grid>
                <span class="entries__duration">{formatDuration(entry.duration)}</span>
              </Grid>
            </wa-card>
          ))}
        </Grid>
      </section>
    </>
  )}
</Layout>

<style>
.progress-bar {
  position: relative;
  width: 100%;
}

.progress-bar__label {
  position: absolute;
  z-index: 1;
  inset-block-start: 50%;
  transform: translateY(-50%);
  color: #FFF;
  font-weight: bold;
  padding-inline-end: var(--wa-space-xs);
  text-align: end;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  pointer-events: none;
  min-width: max-content;
  color: var(--wa-color-brand-90)
}

.progress-bar__hours {
  font-size: var(--wa-font-size-l);
  color: var(--wa-color-neutral-90)
}

.progress-bar__total {
  font-weight: bold;
  text-align: end;
}

wa-progress-bar {
  --track-height: 4.5rem;

  &::part(base) {
    border-radius: var(--wa-border-radius-xl);
  }
}
wa-card {
  --spacing: var(--wa-space-s);
  background-color: var(--wa-color-brand-50);
  color: #FFF;
}

.entries_day {
  width: 2rem;
  aspect-ratio: 1;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  font-weight: bold;
  background-color: var(--wa-color-brand-90);
  border-radius: var(--wa-border-radius-circle);
  color: var(--wa-color-brand-10);
}
.entries__duration {
  font-weight: bold;
}
.entries__no-description {
  color: var(--wa-color-neutral-90);
  font-size: var(--wa-font-size-s);
}
</style>