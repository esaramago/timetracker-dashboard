---
import type { HTMLTag, Polymorphic } from 'astro/types'
import type { Spacing, Break, Align, Justify, Direction } from '../types'

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag
  tag?: Tag
  direction?: Direction
  align?: Align
  justify?: Justify
  gap?: Spacing
  break?: Break
  wrap?: boolean
  fullWidth?: boolean
}>

const {
  as,
  tag = 'div',
  direction,
  align,
  justify,
  gap,
  break: breakPoint,
  wrap,
  fullWidth = false,
  class: className,
  style,
  ...rest
} = Astro.props

const Component = as || tag || 'div'

const gridStyle: Record<string, string> = {}
if (gap) gridStyle['--gap'] = `var(--wa-space-${gap})`
if (align) gridStyle['--align'] = align
if (justify) gridStyle['--justify'] = justify
if (wrap !== undefined) gridStyle['--wrap'] = wrap ? 'wrap' : 'nowrap'
if (direction) gridStyle['--direction'] = direction
---

<Component
  class:list={[
    'l-grid',
    {
      [`break--${breakPoint}`]: Boolean(breakPoint),
      'l-grid--full-width': Boolean(fullWidth),
    },
    className,
  ]}
  style={[gridStyle, style]}
  {...rest}
>
  <slot />
</Component>

<style>
  .l-grid {
    --gap: var(--wa-space-m);
    --align: initial;
    --justify: initial;
    --wrap: initial;
    --direction: initial;
    display: flex;
    flex-direction: var(--direction);
    gap: var(--gap);
    align-items: var(--align);
    justify-content: var(--justify);
    flex-wrap: var(--wrap);
  }

  .l-grid--full-width > :global(*) {
    width: 100%;
    flex: 1;
  }

  @media (max-width: 767px) {
    .break--mobile {
      flex-direction: column;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 1023px) {
    .break--small {
      flex-direction: column;
      flex-wrap: wrap;
    }
  }
</style>

<style is:global>
  .l-grid > [data-grow="1"] {
    flex-grow: 1;
  }
</style>

